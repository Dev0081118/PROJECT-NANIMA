# ============================================================
# MAA — DIGITAL LEGACY: Root Environment Configuration Template
# Placeholders only. Copy relevant sections to maa-backend/.env
# and maa-app/.env. Never commit real credentials.
# ============================================================

# ─── BACKEND CONFIGURATION (maa-backend/.env) ───────────────────
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 15+ with pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/maa_db

# Security & Tokens
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_BYTE_HEX
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# LLM & Embeddings (OpenAI-compatible)
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Indian Language Speech AI (Sarvam AI for Gujarati)
SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_VOICE=REPLACE_WITH_GUJARATI_VOICE_ID

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ─── MOBILE APP CONFIGURATION (maa-app/.env) ─────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
EXPO_PUBLIC_APP_NAME=Maa — Digital Legacy
EXPO_PUBLIC_APP_VERSION=0.1.0
