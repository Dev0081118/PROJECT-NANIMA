# Mobile App Environment
# Copy to .env and fill in your backend URL
# NEVER commit .env to git

# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:3000

# WebSocket URL (usually same host as API, different protocol)
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# App Configuration
EXPO_PUBLIC_APP_NAME=Maa — Digital Legacy
EXPO_PUBLIC_APP_VERSION=0.1.0
